# Modern-profile imported-symbol allowlist (Windows 10 x64 and ARM64).
#
# 11-rust-implementation.md section 8 mandates the Windows-7-SP1 allowlist by
# name; this file is its modern counterpart, and the A3 design section 10 names
# both as the durable mitigation for a static import that is too new. Without
# it the modern images were checked only for module exclusivity, so a new
# ntoskrnl symbol could appear unreviewed.
#
# One "module!symbol" per line, case-insensitive; '#' starts a comment. Like the
# Win7 file, this proves "no import outside the reviewed set" - not that every
# entry is present at the Windows 10 1507 floor. Each provenance note below IS
# the argument for that, checked against the kit headers' NTDDI gates.
#
# ntoskrnl.exe!DbgPrint - present since Windows NT 3.1.
ntoskrnl.exe!DbgPrint
# ntoskrnl.exe!ExAllocatePoolWithTag - wdm.h:25297, gated at NTDDI_WIN2K.
ntoskrnl.exe!ExAllocatePoolWithTag
# ntoskrnl.exe!ExFreePoolWithTag - wdm.h, gated at NTDDI_WIN2K.
ntoskrnl.exe!ExFreePoolWithTag
# ntoskrnl.exe!MmGetSystemRoutineAddress - wdm.h, gated at NTDDI_WIN2K. It is
#   the mechanism section 3 mandates for reaching a post-baseline DDI, so it
#   must itself be a baseline import.
ntoskrnl.exe!MmGetSystemRoutineAddress
# ksecdd.sys!BCryptGenRandom - kernel CNG, Windows Vista SP1 and later, so it
#   is below the 1507 floor.
ksecdd.sys!BCryptGenRandom

# Slice C3 direct imports. The Win10 x64 and ARM64 release link maps attribute
# these import thunks to ntoskrnl.lib, not to the static Wdmsec archive. Header
# lines are from installed WDK 10.0.26100: exactly four rundown imports are
# gated at NTDDI_WINXP and the other eight are gated at NTDDI_WIN2K. Every gate
# predates Win10 1507.
#
# ntoskrnl.exe!ExAcquireRundownProtection - direct ntoskrnl.lib;
#   wdm.h:27868, gated at NTDDI_WINXP.
ntoskrnl.exe!ExAcquireRundownProtection
# ntoskrnl.exe!ExInitializeRundownProtection - direct ntoskrnl.lib;
#   wdm.h:27844, gated at NTDDI_WINXP.
ntoskrnl.exe!ExInitializeRundownProtection
# ntoskrnl.exe!ExReleaseRundownProtection - direct ntoskrnl.lib;
#   wdm.h:27894, gated at NTDDI_WINXP.
ntoskrnl.exe!ExReleaseRundownProtection
# ntoskrnl.exe!ExReInitializeRundownProtection - direct ntoskrnl.lib;
#   wdm.h:27855, gated at NTDDI_WINXP, below Win7 SP1.
ntoskrnl.exe!ExReInitializeRundownProtection
# ntoskrnl.exe!ExWaitForRundownProtectionRelease - direct ntoskrnl.lib;
#   wdm.h:27930, gated at NTDDI_WINXP.
ntoskrnl.exe!ExWaitForRundownProtectionRelease
# ntoskrnl.exe!IoCreateSymbolicLink - direct ntoskrnl.lib; wdm.h:34462,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!IoCreateSymbolicLink
# ntoskrnl.exe!IoDeleteDevice - direct ntoskrnl.lib; wdm.h:34493, gated at
#   NTDDI_WIN2K.
ntoskrnl.exe!IoDeleteDevice
# ntoskrnl.exe!IoQueueWorkItem - direct ntoskrnl.lib;
#   wdm.h:35844, gated at NTDDI_WIN2K, below Win7 SP1.
ntoskrnl.exe!IoQueueWorkItem
# ntoskrnl.exe!IoDeleteSymbolicLink - direct ntoskrnl.lib; wdm.h:34502,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!IoDeleteSymbolicLink
# ntoskrnl.exe!IofCompleteRequest - direct ntoskrnl.lib; wdm.h:33854, gated at
#   NTDDI_WIN2K.
ntoskrnl.exe!IofCompleteRequest
# ntoskrnl.exe!IoGetRequestorProcess - direct ntoskrnl.lib; ntifs.h:20323,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!IoGetRequestorProcess
# ntoskrnl.exe!KeBugCheckEx - direct ntoskrnl.lib; wdm.h:24433, gated at
#   NTDDI_WIN2K.
ntoskrnl.exe!KeBugCheckEx
# ntoskrnl.exe!ObfDereferenceObject - direct ntoskrnl.lib; wdm.h:43356,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!ObfDereferenceObject
# ntoskrnl.exe!ObfReferenceObject - direct ntoskrnl.lib; wdm.h:43310, gated at
#   NTDDI_WIN2K.
ntoskrnl.exe!ObfReferenceObject

# Task 6 permanent-root imports. The final link retains exactly these three
# newly selected generated DDIs. Provenance is the installed WDK 10.0.26100;
# each public declaration is gated at NTDDI_WIN2K, before the Win10 1507 floor.
#
# ntoskrnl.exe!IoAllocateWorkItem - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h:35830; gate NTDDI_WIN2K.
ntoskrnl.exe!IoAllocateWorkItem
# ntoskrnl.exe!IoFreeWorkItem - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h:35837; gate NTDDI_WIN2K.
ntoskrnl.exe!IoFreeWorkItem
# ntoskrnl.exe!KeInitializeSpinLock - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h:23646; gate NTDDI_WIN2K.
ntoskrnl.exe!KeInitializeSpinLock

# Task 19 R4 cutover imports. SETUP now builds each session's pending-ENTER
# runtime, and initializing one slot publishes its cancel-safe queue and arms
# nothing: the timer and its DPC are initialized here and set only by a finite
# WAIT, which the IRP-parking path adds. These three are what that costs at the
# link. Provenance is the installed WDK 10.0.26100; each public declaration is
# gated below the Win10 1507 floor.
#
# ntoskrnl.exe!IoCsqInitialize - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h:36302; gate NTDDI_WINXP.
#   The non-Ex form: the Ex variants are declared in fsring-sys and deliberately
#   uncalled, so neither appears here.
ntoskrnl.exe!IoCsqInitialize
# ntoskrnl.exe!IoCsqInsertIrp - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h; gate NTDDI_WINXP.
#   Void non-Ex insert; marks the IRP pending. The Ex form stays uncalled.
ntoskrnl.exe!IoCsqInsertIrp
# ntoskrnl.exe!IoCsqRemoveIrp - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h; gate NTDDI_WINXP.
#   Sole non-cancel dequeue; cancel already dequeued IRPs return null.
ntoskrnl.exe!IoCsqRemoveIrp
# ntoskrnl.exe!KeInitializeDpc - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h:22978; gate NTDDI_WIN2K.
ntoskrnl.exe!KeInitializeDpc
# ntoskrnl.exe!KeInitializeTimer - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h:23498; gate NTDDI_WIN2K.
ntoskrnl.exe!KeInitializeTimer
# ntoskrnl.exe!KeDelayExecutionThread - direct ntoskrnl.lib; WDK 10.0.26100
#   wdm.h:23317; gate NTDDI_WIN2K. The checkpoint's drain wait sleeps one
#   bounded interval between observations; how many observations, and what may
#   never be observed twice, is `PendingDrainWait` in core and is host tested.
ntoskrnl.exe!KeDelayExecutionThread

# Slice C3 static-Wdmsec imports. Both modern link maps attribute these
# ntoskrnl.exe import thunks to code pulled from wdmsec.lib; wdmsec.sys is not
# a runtime module. Microsoft documents WdmlibIoCreateDeviceSecure plus
# Wdmsec.lib for Windows 2000 and later, below the Win10 1507 floor. Public
# header gates below are independent corroboration. "Wdmsec Win2K+ contract"
# names that documented library baseline where the public declaration is
# ungated or private. Exactly 16 declarations are gated at NTDDI_WIN2K, three
# at NTDDI_WS03SP1, three public declarations are ungated, three kernel-CRT
# declarations are ungated, and two imports are archive-only. The last eight
# use the Wdmsec Win2K+ contract rather than an invented per-symbol NTDDI gate.
#
# ntoskrnl.exe!_snwprintf - static wdmsec.lib; kernel CRT declaration at
#   km/crt/stdio.h:502; no NTDDI gate, with the Wdmsec Win2K+ contract.
ntoskrnl.exe!_snwprintf
# ntoskrnl.exe!_wcsnicmp - static wdmsec.lib; kernel CRT declaration at
#   km/crt/string.h:348; no NTDDI gate, with the Wdmsec Win2K+ contract.
ntoskrnl.exe!_wcsnicmp
# ntoskrnl.exe!IoCreateDevice - static wdmsec.lib; wdm.h:34390, gated at
#   NTDDI_WIN2K.
ntoskrnl.exe!IoCreateDevice
# ntoskrnl.exe!IoDeviceObjectType - static wdmsec.lib data import; no public
#   WDK-header declaration was found. The installed x64 and ARM64 archive
#   indexes both contain __imp_IoDeviceObjectType; baseline is the Wdmsec
#   Win2K+ contract.
ntoskrnl.exe!IoDeviceObjectType
# ntoskrnl.exe!IoIsWdmVersionAvailable - static wdmsec.lib; wdm.h:34415,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!IoIsWdmVersionAvailable
# ntoskrnl.exe!ObOpenObjectByPointer - static wdmsec.lib; ntifs.h:21395,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!ObOpenObjectByPointer
# ntoskrnl.exe!RtlAbsoluteToSelfRelativeSD - static wdmsec.lib; ntifs.h:4248,
#   gated at NTDDI_WS03SP1.
ntoskrnl.exe!RtlAbsoluteToSelfRelativeSD
# ntoskrnl.exe!RtlAddAccessAllowedAce - static wdmsec.lib; ntifs.h:4151,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!RtlAddAccessAllowedAce
# ntoskrnl.exe!RtlCreateSecurityDescriptor - static wdmsec.lib; wdm.h:16366,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!RtlCreateSecurityDescriptor
# ntoskrnl.exe!RtlFreeUnicodeString - static wdmsec.lib; public declaration at
#   wdm.h:14396; ungated, with the Wdmsec Win2K+ contract.
ntoskrnl.exe!RtlFreeUnicodeString
# ntoskrnl.exe!RtlGetDaclSecurityDescriptor - static wdmsec.lib;
#   ntifs.h:4192, gated at NTDDI_WIN2K.
ntoskrnl.exe!RtlGetDaclSecurityDescriptor
# ntoskrnl.exe!RtlGetGroupSecurityDescriptor - static wdmsec.lib;
#   ntifs.h:4233, gated at NTDDI_WS03SP1.
ntoskrnl.exe!RtlGetGroupSecurityDescriptor
# ntoskrnl.exe!RtlGetOwnerSecurityDescriptor - static wdmsec.lib;
#   ntifs.h:4280, gated at NTDDI_WIN2K.
ntoskrnl.exe!RtlGetOwnerSecurityDescriptor
# ntoskrnl.exe!RtlGetSaclSecurityDescriptor - static wdmsec.lib;
#   ntifs.h:4018, gated at NTDDI_WS03SP1.
ntoskrnl.exe!RtlGetSaclSecurityDescriptor
# ntoskrnl.exe!RtlInitUnicodeString - static wdmsec.lib; public declaration at
#   wdm.h:13849; ungated, with the Wdmsec Win2K+ contract.
ntoskrnl.exe!RtlInitUnicodeString
# ntoskrnl.exe!RtlLengthSecurityDescriptor - static wdmsec.lib; wdm.h:16389,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!RtlLengthSecurityDescriptor
# ntoskrnl.exe!RtlLengthSid - static wdmsec.lib; ntifs.h:3983, gated at
#   NTDDI_WIN2K.
ntoskrnl.exe!RtlLengthSid
# ntoskrnl.exe!RtlSetDaclSecurityDescriptor - static wdmsec.lib; wdm.h:16413,
#   gated at NTDDI_WIN2K.
ntoskrnl.exe!RtlSetDaclSecurityDescriptor
# ntoskrnl.exe!SeCaptureSecurityDescriptor - static wdmsec.lib; no public
#   WDK-header declaration was found. The installed x64 and ARM64 archive
