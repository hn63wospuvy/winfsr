ntoskrnl.exe!ZwSetValueKey

# --- C4 additions, measured 2026-08-05 -------------------------------
#
# Every symbol below was observed in the final release image of all
# three profiles by `llvm-readobj --coff-imports`, and is frozen
# positively in driver/audit/c4-imports-*.json. This file grants
# permission; the manifests prove presence. Permission alone is not
# evidence that a required DDI is still linked.
ntoskrnl.exe!EtwRegister
ntoskrnl.exe!EtwUnregister
ntoskrnl.exe!EtwWrite
ntoskrnl.exe!ExEventObjectType
ntoskrnl.exe!IoAcquireVpbSpinLock
ntoskrnl.exe!IoAllocateMdl
ntoskrnl.exe!IoBuildPartialMdl
ntoskrnl.exe!IoFreeMdl
ntoskrnl.exe!IoRegisterFileSystem
ntoskrnl.exe!IoReleaseVpbSpinLock
ntoskrnl.exe!IoUnregisterFileSystem
# ntoskrnl.exe!KeCancelTimer - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h; gate
#   NTDDI_WIN2K. The R6 parked-WAIT repair cancels a finite WAIT's timer at the
#   completion's CancelTimer stage. Without it an armed timer stayed queued
#   while the pool holding its KTIMER and KDPC was freed. The DDI's BOOLEAN is
#   what decides who owns the DPC, so it is fed straight into
#   `TimerState::cancel` rather than inferred.
ntoskrnl.exe!KeCancelTimer
ntoskrnl.exe!KeEnterCriticalRegion
ntoskrnl.exe!KeInitializeEvent
ntoskrnl.exe!KeLeaveCriticalRegion
ntoskrnl.exe!KeReadStateEvent
ntoskrnl.exe!KeSetEvent
# ntoskrnl.exe!KeSetTimer - direct ntoskrnl.lib; WDK 10.0.26100 wdm.h; gate
#   NTDDI_WIN2K. Task 25 residual retry arms the parked KTIMER after the
#   registry lock is dropped.
ntoskrnl.exe!KeSetTimer
ntoskrnl.exe!KeStackAttachProcess
ntoskrnl.exe!KeUnstackDetachProcess
ntoskrnl.exe!KeWaitForSingleObject
ntoskrnl.exe!MmMapLockedPagesSpecifyCache
ntoskrnl.exe!MmMapViewInSystemSpace
ntoskrnl.exe!MmProbeAndLockPages
ntoskrnl.exe!MmSectionObjectType
ntoskrnl.exe!MmUnlockPages
ntoskrnl.exe!MmUnmapLockedPages
ntoskrnl.exe!MmUnmapViewInSystemSpace
ntoskrnl.exe!ObGetObjectSecurity
ntoskrnl.exe!ObReferenceObjectByHandle
ntoskrnl.exe!ObReleaseObjectSecurity
ntoskrnl.exe!PsSetCreateProcessNotifyRoutineEx
ntoskrnl.exe!ZwCreateEvent
ntoskrnl.exe!ZwCreateSection
ntoskrnl.exe!ZwMakeTemporaryObject
ntoskrnl.exe!ZwMapViewOfSection
ntoskrnl.exe!ZwOpenEvent
ntoskrnl.exe!ZwOpenSection
ntoskrnl.exe!ZwQuerySection
ntoskrnl.exe!ZwUnmapViewOfSection
ntoskrnl.exe!__C_specific_handler
ntoskrnl.exe!__chkstk

# Slice C4.2. ntoskrnl.exe!KeExpandKernelStackAndCallout - ntddk.h:9822, gated
#   at NTDDI_WS03SP1, which predates the Windows 10 1507 floor. SETUP uses it
#   to run its own deep validation on a stack it asks for rather than on the
#   12 KB default; see driver/audit/c4-stack-roots.json expansionRoots.
ntoskrnl.exe!KeExpandKernelStackAndCallout

# C4 recovery Task 8. Four DDIs the checked-locator access path executes for the
# first time. Each gate below is a reading of the installed WDK 10.0.26100
# headers, not a measurement against a shipped kernel.
#
# ntoskrnl.exe!KeAcquireSpinLockRaiseToDpc - wdm.h:23805, gated at NTDDI_WIN2K.
#   The per-ring slot lock the access guard takes before it projects ENTER
#   role state.
ntoskrnl.exe!KeAcquireSpinLockRaiseToDpc
# ntoskrnl.exe!KeReleaseSpinLock - wdm.h:23816, gated at NTDDI_WIN2K. The
#   registry and per-ring release, always at the exact IRQL the acquire
#   returned.
ntoskrnl.exe!KeReleaseSpinLock
# ntoskrnl.exe!KeClearEvent - wdm.h:23194, ungated in the header, like
#   KeInitializeEvent beside it. CREATE resets the two per-file SETUP events
#   before a SETUP can arm them.
ntoskrnl.exe!KeClearEvent
# ntoskrnl.exe!ExRundownCompleted - wdm.h:27918, gated at NTDDI_WINXP. Permanently
#   closes the never-published access rundown of a cell retired at generation
#   u64::MAX; that cell is never reused, so the rundown is never reinitialized.
ntoskrnl.exe!ExRundownCompleted
