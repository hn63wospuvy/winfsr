ntoskrnl.exe!ExInitializeRundownProtection
# ntoskrnl.exe!ExReleaseRundownProtection - direct ntoskrnl.lib;
#   wdm.h:27894, gated at NTDDI_WINXP, below Win7 SP1.
ntoskrnl.exe!ExReleaseRundownProtection
# ntoskrnl.exe!ExReInitializeRundownProtection - direct ntoskrnl.lib;
#   wdm.h:27855, gated at NTDDI_WINXP, below Win7 SP1.
ntoskrnl.exe!ExReInitializeRundownProtection
# ntoskrnl.exe!ExWaitForRundownProtectionRelease - direct ntoskrnl.lib;
#   wdm.h:27930, gated at NTDDI_WINXP, below Win7 SP1.
ntoskrnl.exe!ExWaitForRundownProtectionRelease
# ntoskrnl.exe!IoCreateSymbolicLink - direct ntoskrnl.lib; wdm.h:34462,
#   gated at NTDDI_WIN2K, below Win7 SP1.
ntoskrnl.exe!IoCreateSymbolicLink
# ntoskrnl.exe!IoDeleteDevice - direct ntoskrnl.lib; wdm.h:34493, gated at
#   NTDDI_WIN2K, below Win7 SP1.
ntoskrnl.exe!IoDeleteDevice
# ntoskrnl.exe!IoQueueWorkItem - direct ntoskrnl.lib;
