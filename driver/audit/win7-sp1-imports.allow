ntoskrnl.exe!IoQueueWorkItem
# ntoskrnl.exe!IoDeleteSymbolicLink - direct ntoskrnl.lib; wdm.h:34502,
#   gated at NTDDI_WIN2K, below Win7 SP1.
ntoskrnl.exe!IoDeleteSymbolicLink
# ntoskrnl.exe!IofCompleteRequest - direct ntoskrnl.lib; wdm.h:33854, gated at
